<Window x:Class="LivePhotoViewer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="灵动相册 MotionAlbum"
        Height="860"
        Width="1480"
        MinHeight="700"
        MinWidth="1080"
        Icon="Assets/app_icon.ico"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarRowStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <Style x:Key="MetricButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        </Style>

        <Style x:Key="TagChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="SidebarSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid x:Name="HitArea" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="1"
                                    Margin="0,12"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}"/>
                            <Border x:Name="Grip"
                                    Width="4"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#B81677FF"
                                    CornerRadius="2"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#0D1677FF"/>
                                <Setter TargetName="Track" Property="Width" Value="3"/>
                                <Setter TargetName="Track" Property="Background" Value="#B81677FF"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="HitArea" Property="Background" Value="#141677FF"/>
                                <Setter TargetName="Track" Property="Width" Value="3"/>
                                <Setter TargetName="Track" Property="Background" Value="#E61677FF"/>
                                <Setter TargetName="Grip" Property="Background" Value="#F21677FF"/>
                                <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- VS Code 风格顶栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnToggleSidebar" Grid.Column="0" Content="☰" Width="34" Click="BtnToggleSidebar_Click" ToolTip="显示/隐藏侧边栏 (Ctrl+B)" Style="{StaticResource FlatButtonStyle}"/>
                <Button Grid.Column="1" Content="📂" Width="38" Margin="6,0" Click="BtnOpenFolder_Click" ToolTip="打开照片文件夹" Style="{StaticResource FlatButtonStyle}"/>
                <TextBlock x:Name="QuoteText" Grid.Column="2" Text="❝  把时间折好，放进相册  ·  灵动相册" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="8,0">
                    <Grid>
                        <TextBlock x:Name="SearchHintText" Text="搜索文件名、标签、地点或目录" Foreground="{DynamicResource DimTextBrush}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" Padding="12,7" VerticalContentAlignment="Center" ToolTip="搜索文件名、标签、地点或目录"/>
                    </Grid>
                </Border>
                <Button Grid.Column="4" x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" ToolTip="切换主题" Style="{StaticResource FlatButtonStyle}" Width="38">
                    <TextBlock x:Name="ThemeIconText" Text="🌙" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- 图库工作区 -->
        <Grid x:Name="GridMode" Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="238" MinWidth="210" MaxWidth="600"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,3,4,14">
                        <Image Source="Assets/app_icon.png" Width="44" Height="44" Stretch="UniformToFill"/>
                        <StackPanel Margin="10,2,0,0">
                            <TextBlock Text="灵动相册" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="MotionAlbum" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="▱  当前目录" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}"/>
                                <Button DockPanel.Dock="Right" Content="↻" Width="26" Height="24" Click="BtnRefresh_Click" ToolTip="重新扫描" Style="{StaticResource FlatButtonStyle}"/>
                            </DockPanel>
                            <TextBlock x:Name="CurrentPathText" Text="尚未选择" Margin="0,10,0,8" TextWrapping="Wrap" MaxHeight="42" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                            <Button Content="📂  切换文件夹" Click="BtnOpenFolder_Click" Style="{StaticResource FlatButtonStyle}" Background="#1677FF" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="▱  资源管理器" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                    <Button Content="◴  最近打开" Click="BtnRecentFolders_Click" Style="{StaticResource SidebarRowStyle}" HorizontalContentAlignment="Left"/>
                                    <Separator Margin="0,4"/>
                                    <CheckBox x:Name="IncludeSubfoldersCheckBox" Content="包含所选目录的子目录" IsChecked="False" Click="IncludeSubfoldersCheckBox_Click" Padding="7,5"/>
                                    <Separator Margin="0,4"/>
                                    <TreeView x:Name="DirectoryTreeView"
                                              SelectedItemChanged="DirectoryTreeView_SelectedItemChanged"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              MaxHeight="280"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTipText}"/>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="▣  照片库" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                    <Button x:Name="BtnFilterAll" Tag="All" Click="FilterButton_Click" Style="{StaticResource SidebarRowStyle}">
                                        <DockPanel><TextBlock Text="▣  全部"/><TextBlock x:Name="AllCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource SubTextBrush}"/></DockPanel>
                                    </Button>
                                    <Button x:Name="BtnFilterLive" Tag="Live" Click="FilterButton_Click" Style="{StaticResource SidebarRowStyle}">
                                        <DockPanel><TextBlock Text="◎  仅实况"/><TextBlock x:Name="LiveCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource SubTextBrush}"/></DockPanel>
                                    </Button>
                                    <Button x:Name="BtnFilterVideo" Tag="Video" Click="FilterButton_Click" Style="{StaticResource SidebarRowStyle}">
                                        <DockPanel><TextBlock Text="▶  仅视频"/><TextBlock x:Name="VideoCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource SubTextBrush}"/></DockPanel>
                                    </Button>
                                    <Button x:Name="BtnFilterFavorite" Tag="Favorite" Click="FilterButton_Click" Style="{StaticResource SidebarRowStyle}">
                                        <DockPanel><TextBlock Text="♥  我喜欢"/><TextBlock x:Name="FavoriteCountText" DockPanel.Dock="Right" Text="0" Foreground="{DynamicResource SubTextBrush}"/></DockPanel>
                                    </Button>
                                    <Separator x:Name="TagFilterSeparator" Margin="0,5" Visibility="Collapsed"/>
                                    <StackPanel x:Name="TagFilterPanel"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="9">
                                <StackPanel>
                                    <TextBlock Text="⌘  操作" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>
                                    <Button x:Name="BtnExport" Content="⇧  导出当前筛选" Click="BtnExport_Click" Style="{StaticResource SidebarRowStyle}" HorizontalContentAlignment="Left"/>
                                    <Button x:Name="BtnSyncAndroid" Content="⇥  同步我喜欢到安卓手机" Click="BtnSyncAndroid_Click" Style="{StaticResource SidebarRowStyle}" HorizontalContentAlignment="Left"/>
                                    <Button x:Name="BtnTrashFavorites" Content="♲  将我喜欢移入回收站" Click="BtnTrashFavorites_Click" Style="{StaticResource SidebarRowStyle}" HorizontalContentAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Text="✦  神马都会亿点点的毛毛张" Margin="5,12,0,0" FontSize="10" Foreground="{DynamicResource DimTextBrush}"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter"
                          Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Style="{StaticResource SidebarSplitterStyle}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          DragCompleted="SidebarSplitter_DragCompleted"
                          MouseDoubleClick="SidebarSplitter_MouseDoubleClick"
                          ToolTip="沿整条边界左右拖动调整宽度；双击恢复默认宽度"/>

            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="28"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="照片库" FontSize="28" FontWeight="Bold"/>
                                <TextBlock x:Name="LibraryPathText" Text="请选择一个照片文件夹" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Tag="All" Click="FilterButton_Click" Style="{StaticResource MetricButtonStyle}"><TextBlock x:Name="MetricAllText" Text="▣  全部  0" TextWrapping="NoWrap"/></Button>
                                    <Button Tag="Live" Click="FilterButton_Click" Style="{StaticResource MetricButtonStyle}"><TextBlock x:Name="MetricLiveText" Text="◎  实况  0" TextWrapping="NoWrap"/></Button>
                                    <Button Tag="Video" Click="FilterButton_Click" Style="{StaticResource MetricButtonStyle}"><TextBlock x:Name="MetricVideoText" Text="▶  视频  0" TextWrapping="NoWrap"/></Button>
                                    <Button Tag="Favorite" Click="FilterButton_Click" Style="{StaticResource MetricButtonStyle}"><TextBlock x:Name="MetricFavoriteText" Text="♥  喜欢  0" TextWrapping="NoWrap"/></Button>
                                    <Button IsHitTestVisible="False" Style="{StaticResource MetricButtonStyle}"><TextBlock x:Name="MetricTagText" Text="◇  标签  0" TextWrapping="NoWrap"/></Button>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="SortComboBox" Width="92" SelectionChanged="SortComboBox_SelectionChanged" ToolTip="排序" Margin="0,0,8,0">
                                        <ComboBoxItem Content="新到旧" Tag="Newest" IsSelected="True"/>
                                        <ComboBoxItem Content="旧到新" Tag="Oldest"/>
                                        <ComboBoxItem Content="修改时间" Tag="Modified"/>
                                        <ComboBoxItem Content="文件名" Tag="Name"/>
                                    </ComboBox>
                                    <CheckBox x:Name="GroupByTimeCheckBox" Content="按时间分组" IsChecked="True" Click="GroupByTimeCheckBox_Click" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="⌕−" Width="34" Click="GalleryZoomOut_Click" ToolTip="缩小一级" Style="{StaticResource FlatButtonStyle}"/>
                                    <Slider x:Name="GalleryZoomSlider" Width="132" Minimum="0" Maximum="1" Value="0.205258" ValueChanged="GalleryZoomSlider_ValueChanged" Margin="6,0" ToolTip="拖动调整照片大小"/>
                                    <Button Content="⌕+" Width="34" Click="GalleryZoomIn_Click" ToolTip="放大一级" Style="{StaticResource FlatButtonStyle}"/>
                                    <Button x:Name="BtnReturnPrevious" Content="↶  返回上次查看" Click="BtnReturnPrevious_Click" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                                    <Button x:Name="BtnReturnCurrent" Content="⌾  回到当前查看" Click="BtnReturnCurrent_Click" Visibility="Collapsed" Margin="8,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                                    <Button Content="↑  回到顶部" Click="BtnScrollTop_Click" Margin="8,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource ThumbAreaBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                        <ScrollViewer x:Name="GalleryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="GalleryScrollViewer_PreviewMouseWheel" ScrollChanged="GalleryScrollViewer_ScrollChanged" IsManipulationEnabled="True" ManipulationStarting="GalleryScrollViewer_ManipulationStarting" ManipulationDelta="GalleryScrollViewer_ManipulationDelta">
                            <StackPanel x:Name="ThumbnailPanel" Margin="16"/>
                        </ScrollViewer>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="8,6,8,0">
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                        <ProgressBar x:Name="WorkProgressBar" Width="150" Height="4" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="VisibleCountText" DockPanel.Dock="Right" Foreground="{DynamicResource SubTextBrush}" FontSize="10"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 查看器覆盖层 -->
        <Border x:Name="ViewerMode" Grid.Row="1" Margin="8" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBgBrush}" CornerRadius="14,14,0,0" Padding="12,9">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnViewerPrevious" Content="‹  上一张" Click="ViewerPrev_Click" ToolTip="上一张 (←/A)" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerNext" Content="下一张  ›" Click="ViewerNext_Click" ToolTip="下一张 (→/D)" Margin="6,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerPlay" Content="▶  播放实况" Click="ViewerPlay_Click" ToolTip="播放实况 (空格)" Visibility="Collapsed" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerZoomOut" Content="⌕−" Click="ViewerZoomOut_Click" Margin="12,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerZoomPercent" Content="100%" Click="ViewerResetZoom_Click" Margin="6,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerZoomIn" Content="⌕+" Click="ViewerZoomIn_Click" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerFavorite" Content="♡  我喜欢" Click="ViewerFav_Click" Margin="12,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerEditCover" Content="◴  停留画面" Click="ViewerEditCover_Click" Margin="6,0,0,0" Visibility="Collapsed" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="BtnViewerTrash" Content="♲  回收站" Click="ViewerTrash_Click" Margin="6,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="返回图库" Click="ViewerClose_Click" Style="{StaticResource FlatButtonStyle}"/>
                    </DockPanel>
                </Border>

                <Grid x:Name="ViewerImageContainer" Grid.Row="1" Background="{DynamicResource ViewerBgBrush}" MouseWheel="ViewerImageContainer_MouseWheel" MouseLeftButtonDown="ViewerImageContainer_MouseLeftButtonDown" MouseMove="ViewerImageContainer_MouseMove" MouseLeftButtonUp="ViewerImageContainer_MouseLeftButtonUp" IsManipulationEnabled="True" ManipulationStarting="ViewerImageContainer_ManipulationStarting" ManipulationDelta="ViewerImageContainer_ManipulationDelta">
                    <Image x:Name="ViewerImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ViewerScaleTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ViewerTranslateTransform"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <vlc:VideoView x:Name="ViewerVideoView" Visibility="Collapsed"/>
                    <Button x:Name="LeftNavZone" Content="‹" FontSize="34" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="82" Opacity="0.35" Click="ViewerPrev_Click" Background="Transparent" BorderThickness="0"/>
                    <Button x:Name="RightNavZone" Content="›" FontSize="34" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="82" Opacity="0.35" Click="ViewerNext_Click" Background="Transparent" BorderThickness="0"/>
                </Grid>

                <Border x:Name="CoverFrameEditor" Grid.Row="2" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock Text="播放结束停留画面" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="恢复封面" Click="CoverFrameRestore_Click" Style="{StaticResource FlatButtonStyle}"/>
                            <Button Content="取消" Click="CoverFrameCancel_Click" Margin="6,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button Content="设为停留画面" Click="CoverFrameApply_Click" Background="#1677FF" Foreground="White" BorderThickness="0" Style="{StaticResource FlatButtonStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="CoverFrameTimeText" Text="00:00.000" Width="78" VerticalAlignment="Center"/>
                        <Slider x:Name="CoverFrameSlider" Minimum="0" Maximum="1" ValueChanged="CoverFrameSlider_ValueChanged" VerticalAlignment="Center" Margin="8,0,16,0"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource ToolbarBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                    <DockPanel>
                        <WrapPanel x:Name="ViewerTagsPanel"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox x:Name="TagInputBox" Width="140" Padding="7,4" KeyDown="TagInputBox_KeyDown"/>
                            <Button Content="添加标签" Click="BtnAddTag_Click" Margin="6,0,0,0" Style="{StaticResource FlatButtonStyle}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="4" Background="{DynamicResource ToolbarBgBrush}" CornerRadius="0,0,14,14" Padding="14,8">
                    <TextBlock x:Name="ViewerInfoText" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
