<UserControl x:Class="LivePhotoViewer.WPF.Controls.ThumbnailCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Cursor="Hand">
    <Border x:Name="CardBorder"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="6" Opacity="0.10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ImageHost"
                    Grid.Row="0"
                    Background="{DynamicResource ThumbPlaceholderBgBrush}"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="LoadingText"
                               Text="加载中…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DimTextBrush}"
                               FontSize="12"/>

                    <Image x:Name="ThumbImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed"/>

                    <Border x:Name="FocusBadge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#F59E0B"
                            CornerRadius="10"
                            Padding="7,3"
                            Margin="8"
                            Visibility="Collapsed">
                        <TextBlock Text="👁  当前查看" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <Border x:Name="MediaBadge"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#B8000000"
                            CornerRadius="10"
                            Padding="7,3"
                            Margin="8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="MediaBadgeText" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <Button x:Name="FavoriteButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="38"
                            Height="38"
                            Margin="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="FavoriteButton_Click"
                            ToolTip="加入我喜欢">
                        <TextBlock x:Name="FavoriteIcon"
                                   Text="♡"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="DetailsPanel" Grid.Row="1" Margin="3,9,3,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="FileNameText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MetaText"
                               Margin="0,4,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource SubTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <WrapPanel x:Name="TagsPanel" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ShowcaseHint"
                           Grid.Column="1"
                           Text="双击查看  ⛶"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
